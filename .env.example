# Q-Identity Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# DATABASE
# ============================================
# PostgreSQL (production)
DATABASE_URL=postgresql://qidentity:changeme@localhost:5432/qidentity

# SQLite (development - default)
# DATABASE_URL=sqlite:///./qidentity.db

# ============================================
# SECURITY
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ============================================
# AUTHENTICATION
# ============================================
# Challenge expiration in seconds (default: 30)
CHALLENGE_EXPIRATION_SECONDS=30

# ============================================
# BLOCKCHAIN (Optional)
# ============================================
# Ethereum RPC URL (for real blockchain integration)
# BLOCKCHAIN_RPC_URL=http://localhost:8545
# BLOCKCHAIN_PRIVATE_KEY=your-blockchain-private-key
# BLOCKCHAIN_CONTRACT_ADDRESS=0x...

# ============================================
# REDIS (Optional - for caching/sessions)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# QUANTUM ANALYSIS
# ============================================
# Enable liboqs for hardware-accelerated ML-DSA
# ENABLE_LIBOQS=false